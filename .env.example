# --- Runtime ---
WORKER_ENV=dev
WORKER_CONCURRENCY=2

# --- PostgreSQL (owned by echo-api) ---
DATABASE_URL=postgresql://echo:echo@localhost:5432/echo

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
TRANSCRIPTION_QUEUE=media_transcription_queue
SUMMARY_QUEUE=media_summary_queue

# --- Transcription ---
# local: faster-whisper | openai: Whisper API | fake: deterministic dev stub
WHISPER_MODE=local
# Modelo padrão: large-v3 (o melhor). Deixe comentado para usar o padrão.
WHISPER_MODEL=large-v3
# O dispositivo (cuda/cpu) e o compute_type são detectados automaticamente
# pelo código conforme o hardware disponível (GPU NVIDIA -> cuda/float16,
# caso contrário -> cpu/int8). Não defina WHISPER_DEVICE ou
# WHISPER_COMPUTE_TYPE aqui.

# --- Summary ---
# openai: chat completions | fake: deterministic dev stub
SUMMARY_MODE=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_MODEL=gpt-4o-mini

# --- Object storage (MinIO / S3) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=echo_dev
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# --- Temp files ---
TEMP_DIR=/tmp/echo-worker

# --- Sentry (worker) ---
SENTRY_DSN_WORKER=

# --- Loki (logs estruturados do worker) ---
LOKI_URL=http://localhost:3100
